# Glide API Credentials
# Get your API key from https://docs.glideapi.com/

# REQUIRED - Your Glide API Key
GLIDE_API_KEY=your_api_key_here

# OPTIONAL - API Base URL (defaults to production)
GLIDE_API_BASE_URL=https://api.glideidentity.app

# OPTIONAL - Debug logging
GLIDE_DEBUG=false

# OPTIONAL - Server configuration
# NUXT_PORT=3000
# NITRO_PORT=3001